# browserless/.env.template
#
# Esta plantilla DOCUMENTA las variables que browserless necesita. NO se
# usa directamente — el .env real lo genera scripts/setup.sh en la raíz
# del repo (en la VM) leyendo Secret Manager y combinando los valores.
#
# Las variables abajo terminan en el `.env` raíz que docker-compose lee.

# Auth token que browserless exige en query string `?token=...` o header
# `Authorization: Bearer ...`. Generado por setup.sh con `openssl rand -hex 32`
# y subido a Secret Manager como `leyvascents-browserless-token`.
BROWSERLESS_TOKEN=

# Bright Data residencial MX. Estos 3 vienen ya pre-creados en Secret
# Manager (leyvascents-brightdata-*).
BRIGHTDATA_ENDPOINT=brd.superproxy.io:33335
BRIGHTDATA_USERNAME=brd-customer-XXX-zone-XXX
BRIGHTDATA_PASSWORD=

# Variable derivada que se inyecta directo a browserless via env.
# Formato exigido por Chromium --proxy-server:
#   http://user:pass@host:port
# setup.sh la construye como:
#   PROXY_SERVER=http://${BRIGHTDATA_USERNAME}:${BRIGHTDATA_PASSWORD}@${BRIGHTDATA_ENDPOINT}
PROXY_SERVER=
