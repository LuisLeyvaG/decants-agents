{
  "name": "@leyvascents/agents-workflows",
  "version": "0.1.0",
  "private": true,
  "description": "Workflows de n8n versionados como código + schemas Zod + system prompts del sistema agéntico de Leyva Scents.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:schema": "tsx scripts/build-output-schema.ts",
    "build:prompt": "tsx scripts/build-prompt.ts",
    "pretest": "npm run build:schema && npm run build:prompt",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint placeholder — TODO: configurar eslint cuando haya código TS'",
    "start:sourcing-scout": "node --import tsx 02-sourcing-scout/server/server.ts"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^5.6.0",
    "cheerio": "^1.0.0",
    "pg": "^8.13.1",
    "tsx": "^4.22.3",
    "ulid": "^2.4.0",
    "undici": "^6.26.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
