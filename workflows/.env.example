# Bright Data residential-proxy secrets for Agente 2 (Sourcing Scout).
# Copy this file to `.env` (which is gitignored) and fill in real values, OR
# rely on n8n / GCP Secret Manager to inject these at runtime. NEVER commit .env.
#
# In production these come from GCP Secret Manager:
#   BRIGHTDATA_ENDPOINT  <- leyvascents-brightdata-endpoint
#   BRIGHTDATA_USERNAME  <- leyvascents-brightdata-username
#   BRIGHTDATA_PASSWORD  <- leyvascents-brightdata-password

# Gateway host:port (residential proxy CONNECT gateway). No scheme needed.
BRIGHTDATA_ENDPOINT=brd.superproxy.io:33335

# Base username (zone). Sticky sessions append `-session-<id>` automatically.
BRIGHTDATA_USERNAME=brd-customer-hl_ee9d698f-zone-leyvascents_mx

# Zone password. Keep secret. Special characters are URL-encoded by the wrapper.
BRIGHTDATA_PASSWORD=replace-me

# Path to Bright Data's zone SSL-inspection CA (PEM). Bright Data terminates TLS
# at its super-proxy and presents its own root, so without this CA every HTTPS
# fetch fails with SELF_SIGNED_CERT_IN_CHAIN. Download it from the dashboard:
#   zone leyvascents_mx -> "SSL certificate" -> Download, save under certs/.
# The wrapper trusts this CA ONLY for proxy traffic (ProxyAgent requestTls.ca),
# NEVER globally. There is no insecure fallback — a missing CA is a hard error.
# certs/ is gitignored. Use an absolute path or one relative to where you run node.
BRIGHTDATA_CA_CERT=02-sourcing-scout/certs/brightdata-ca.crt

# Google Maps (Places API NEW) key for the Maps source adapter (Agente 2 — 3.1).
# In production injected from GCP Secret Manager: leyvascents-gmaps-api-key.
# The key must have the Places API (New) enabled AND allowlist the n8n VM egress
# IP 34.29.82.60. Maps does NOT go through Bright Data — it calls Google directly.
GOOGLE_MAPS_API_KEY=replace-me
